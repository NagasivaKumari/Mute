{
  "name": "sentinel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "dev:backend": "pnpm --filter @sentinel/backend dev",
    "dev:dashboard": "pnpm --filter @sentinel/dashboard dev",
    "dev:runtime": "pnpm --filter @sentinel/runtime dev",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "validate:structure": "node scripts/validate-structure.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/minimatch": "3.0.5"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
